# Local settings (copy to .env; never commit .env)
# MTR_DATA: the local test data (repos, state, Hebrew side); default ./.local
MTR_DATA=
# MTR_SESSION_SECRET: signs the session cookie; default a random secret kept in $MTR_DATA/state/secret
MTR_SESSION_SECRET=
# GitHub (all five, or none for the local test; PLAN.md section 12). On Netlify these are the site's environment variables.
# MTR_GITHUB_PRIVATE_KEY: the App's private key as PEM (newlines may be written \n) or base64 of the PEM.
# With GitHub, MTR_SESSION_SECRET is required (it seals the session cookie, which holds the user's token).
MTR_GITHUB_APP_ID=
MTR_GITHUB_PRIVATE_KEY=
MTR_GITHUB_CLIENT_ID=
MTR_GITHUB_CLIENT_SECRET=
MTR_GITHUB_ORG=
# MTR_GITHUB_PRIVATE=1: also list private language repos (a test against a private repo; never on a public site)
MTR_GITHUB_PRIVATE=
