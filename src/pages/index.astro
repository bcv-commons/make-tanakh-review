---
// The editor is the start page: the chapter last opened (cookie), else the first chapter of the first language.
import { languages, storeFor } from "../lib/config.js";
import { chapters } from "../lib/service.js";
const last = Astro.cookies.get("mtr_last")?.value || "";
const [lang, book, ch] = last.split("/");
const store = lang && await storeFor(lang);
if (store && (await chapters(store)).some((c) => c.book === book && c.chapter === Number(ch))) return Astro.redirect(`/edit/${lang}/${book}/${ch}`);
const l = (await languages())[0];
const c = l && (await chapters(await storeFor(l)))[0];
if (!c) return new Response("No language repos yet: run tools/prepare_chapter.py and tools/init_local.sh.", { status: 404 });
return Astro.redirect(`/edit/${l}/${c.book}/${c.chapter}`);
---
