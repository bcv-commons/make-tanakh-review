---
// The editor (PLAN.md sections 6-7): per verse the Hebrew clauses next to the target's clause units. Reading needs no sign-in;
// signed in, the user edits their own proposal (or main, until the first save makes one).
import Base from "../../../../layouts/Base.astro";
import Nav from "../../../../components/Nav.astro";
import { storeFor, hebrew, sourceIndex, lexemeGlosses, languageName, languageTag, rememberLanguage } from "../../../../lib/config.js";
import { currentUser } from "../../../../lib/session.js";
import { load, chapterPath, roles } from "../../../../lib/service.js";
const { lang, book, ch } = Astro.params;
const user = await currentUser(Astro.cookies);
const store = await storeFor(lang, user);
const file = store && /^[A-Z0-9]{3}$/.test(book) && /^\d{1,3}$/.test(ch) ? chapterPath(book, Number(ch)) : null;
const d = file ? await load(store, user?.login, file, { index: sourceIndex(book), glossFallback: () => lexemeGlosses(lang) }) : null;
if (!d) return new Response("No such chapter", { status: 404 });
rememberLanguage(lang, d.language);
Astro.cookies.set("mtr_last", `${lang}/${book}/${Number(ch)}`, { path: "/", sameSite: "lax", maxAge: 60 * 60 * 24 * 365 });
const heb = (await hebrew(book, Number(ch))).verses;
const data = {
  lang, file, book, chapter: Number(ch), user: user && { login: user.login, agreed: !!user.agreed, ...(await roles(store, user.login)) },
  branch: d.branch, pr: d.pr && { number: d.pr.number, status: d.pr.status }, units: d.units,
  version: d.version, main: d.main, approved: d.approved, hebrew: heb,
  verses: d.verses, title: d.title, headings: d.headings, notes: d.notes, poetry: d.poetry,
  renderings: d.renderings, glosses: d.glosses, glossSource: d.glossSource, langName: languageName(lang), langTag: languageTag(lang),
  status: d.status, publisher: d.publisher,
  alternatives: d.alternatives,
};
---
<Base title={`${book} ${ch} (${languageName(lang)})`}>
  <Nav slot="nav" lang={lang} book={book} ch={ch} />
  <div id="bar" class="bar"></div>
  <details class="help">
    <summary>How to edit</summary>
    <ul>
      <li>Each box is one clause of the translation, next to the Hebrew clause it renders. Change the words freely.</li>
      <li>Type <kbd>#</kbd> where a clause should be <b>split</b> in two (or put the cursor there and press ✂).</li>
      <li>Type <kbd>%</kbd> as the <b>first</b> letter to join a clause with the one before, or as the <b>last</b> letter to join it
        with the one after (or press ⤒ / ⤓). Joins stay within a verse.</li>
      <li>A real <kbd>#</kbd> or <kbd>%</kbd> in the text: type <kbd>\#</kbd>, <kbd>\%</kbd>.</li>
      <li><b>Save</b> (Ctrl+S) makes your edits a proposal; a reviewer merges it into the working text. Edits are CC0.</li>
      <li>Each verse's words are linked to the Hebrew. When you change a verse's text, its links are carried over to your new
        wording on save (words you replaced lose theirs) and the verse shows <b>check links</b> until someone checks them.</li>
      <li>Notes from the drafters stand under their verse: T text-critical, E exegetical, H cross-reference, N to the reviewers.</li>
      <li>Where the chapter has <b>other drafts</b> (made by other methods), each one's words for the same Hebrew clause stand under the
        box (<b>use</b> puts them in the box). Words of the box that no other draft has in this clause are shaded strongly, words
        only some have lightly: places to look at first, not errors.</li>
    </ul>
  </details>
  <div id="editor" class="editor"></div>
  <div id="dialog"></div>
  <script type="application/json" id="data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>
  <script>
    import { start } from "../../../../client/editor.js";
    start(JSON.parse(document.getElementById("data").textContent));
  </script>
</Base>
