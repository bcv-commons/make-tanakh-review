---
// The page frame: title bar, sign-in state, a message line (?msg=) and the CC0 note.
import { currentUser } from "../lib/session.js";
import { githubSettings } from "../lib/config.js";
const github = !!githubSettings();
const { title } = Astro.props;
const user = await currentUser(Astro.cookies);
const msg = Astro.url.searchParams.get("msg");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · make-tanakh-review</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/" title="make-tanakh-review">MTR</a>
      <slot name="nav" />
      <div class="who">
        {user ? (
          <form method="post" action="/api/signout">
            <span>Signed in as <b>{user.login}</b></span> <button class="link">sign out</button>
          </form>
        ) : (
          <form method="post" action="/api/signin" class="signin">
            <input type="hidden" name="next" value={Astro.url.pathname} />
            {!github && <input name="login" placeholder="GitHub login" required size="14" autocomplete="username" />}
            <label title="Asked once, at the first sign-in"><input type="checkbox" name="agree" /> my edits are CC0</label>
            <button>{github ? "sign in with GitHub" : "sign in"}</button>
          </form>
        )}
      </div>
    </header>
    {msg && <p class="msg">{msg}</p>}
    <main><slot /></main>
    <footer>
      Drafts and edits: CC0 1.0. Hebrew text and glosses: MACULA Hebrew (WLC), CC BY 4.0. Clause units: bcv-commons
      hebrew-clause-layout (from MACULA Hebrew), CC BY 4.0.{!github && " Local test: sign-in by name only, no GitHub."}
    </footer>
  </body>
</html>
